  "keyFeatures": [
    "AI-powered browser automation with natural language prompts",
    "Workflow orchestration combining Python code and natural language",
    "Structured data extraction from web pages using Pydantic schemas",
    "Human-in-the-loop capabilities for approval and UI takeover",
    "Deploy workflows to AWS AgentCore Runtime at scale",
    "Parallel browser session management",
    "Security controls with state guardrails and file permissions",
    "Tool integration beyond the browser (APIs, MCP servers)"
  ],
  "publicApiSurface": [
    "NovaAct - Main client class for browser automation",
    "NovaAct.act() - Execute browser automation tasks",
    "NovaAct.act_get() - Execute tasks and extract structured data",
    "Workflow - Context manager for workflow orchestration",
    "@workflow - Decorator for workflow functions",
    "@tool - Decorator for custom tools",
    "SecurityOptions - Configure security controls",
    "GuardrailDecision - Control URL navigation",
    "HumanInputCallbacksBase - Implement HITL patterns",
    "ActError - Base exception class for errors",
    "BOOL_SCHEMA - Boolean response schema",
    "STRING_SCHEMA - String response schema"
  ]
